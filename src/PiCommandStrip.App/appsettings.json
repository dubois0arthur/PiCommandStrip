{
  "PiCommandStrip": {
    "Network": {
      "LanEnabled": false,
      "ListenAddress": "127.0.0.1",
      "Port": 5077
    },
    "Commands": {
      "CooldownMilliseconds": 750
    },
    "Contexts": {
      "ProcessMappings": {
        "media": [ "spotify" ],
        "browser": [ "firefox", "chrome", "msedge" ],
        "gaming": [],
        "audio": []
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
