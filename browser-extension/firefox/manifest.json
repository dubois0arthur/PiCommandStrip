{
  "manifest_version": 3,
  "name": "PiCommandStrip Firefox Bridge",
  "version": "0.1.0",
  "description": "Shares concise Firefox research context with the local PiCommandStrip Windows host and executes fixed browser actions.",
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "selection.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-bridge@picommandstrip.local",
      "strict_min_version": "147.0",
      "data_collection_permissions": {
        "required": [
          "websiteActivity",
          "websiteContent"
        ]
      }
    }
  }
}
